{
  "name": "@mic-sob/garmin-connect-personal-api",
  "version": "0.1.0",
  "description": "TypeScript client for the Garmin Connect Personal API",
  "homepage": "https://github.com/mic-sob/garmin-connect-personal-api#readme",
  "bugs": {
    "url": "https://github.com/mic-sob/garmin-connect-personal-api/issues"
  },
  "license": "Apache-2.0",
  "author": "mic-sob",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mic-sob/garmin-connect-personal-api.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "generate:types": "node scripts/fetch-openapi.mjs && pnpm dlx openapi-typescript@7.13.0 openapi.patched.json -o src/types/garmin.ts",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
