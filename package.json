{
  "name": "@micsob/garmin-connect-personal-api",
  "version": "0.1.0",
  "description": "TypeScript client for the Garmin Connect Personal API",
  "keywords": [
    "activity",
    "fitness",
    "garmin",
    "garmin-connect",
    "health",
    "hrv",
    "personal-api",
    "sleep"
  ],
  "homepage": "https://github.com/mic-sob/garmin-connect-personal-api#readme",
  "bugs": {
    "url": "https://github.com/mic-sob/garmin-connect-personal-api/issues"
  },
  "license": "Apache-2.0",
  "author": "Michal Sobecki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mic-sob/garmin-connect-personal-api.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "generate:types": "node scripts/fetch-openapi.mjs && pnpm dlx openapi-typescript@7.13.0 openapi.patched.json -o src/types/garmin.ts",
    "prepublishOnly": "vp pack --attw --publint",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.5",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
